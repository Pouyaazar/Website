{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/video/scripts/setup.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "env": {
    "HYPERFRAMES_SKIP_SKILLS": "1"
  },
  "extraKnownMarketplaces": {
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    }
  },
  "enabledPlugins": {
    "hyperframes@hyperframes": true
  }
}
